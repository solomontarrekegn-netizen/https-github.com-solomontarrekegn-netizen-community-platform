# Environment variables example for Ask Community

# Local development using SQLite (recommended for quick local dev):
# 1) Set DATABASE_URL to a local sqlite file
#    DATABASE_URL="file:./dev.db"
# 2) In prisma/schema.prisma change datasource provider to "sqlite" for local dev (see README)

# Production using PostgreSQL (recommended for deployments):
# Example:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Email provider (optional; required for email sign-in)
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=no-reply@example.com

# OAuth providers (example)
# GITHUB_ID=your_github_client_id
# GITHUB_SECRET=your_github_client_secret

# Optional public env for the frontend
# NEXT_PUBLIC_SITE_NAME="Ask Community"
