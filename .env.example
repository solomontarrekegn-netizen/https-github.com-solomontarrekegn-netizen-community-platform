# Environment variables example for Ask Community

# Local (SQLite dev) example:
DATABASE_URL="file:./dev.db"

# For production use PostgreSQL, example:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Optional
# NEXT_PUBLIC_ENV_VAR=your_public_value
